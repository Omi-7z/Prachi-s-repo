# Postgres. Vercel → Storage → Postgres (Neon) sets DATABASE_URL / POSTGRES_URL for you.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs facilitator session cookies. Any random 32+ characters:  openssl rand -base64 48
SESSION_SECRET=

# Server-side only; never shipped to a browser.
ANTHROPIC_API_KEY=

# Self-hosted Whisper for /api/transcribe (optional until transcription is built out)
WHISPER_URL=
WHISPER_TOKEN=
