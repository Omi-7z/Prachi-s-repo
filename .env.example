# Postgres. Vercel → Storage → Postgres (Neon) sets DATABASE_URL / POSTGRES_URL for you.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs facilitator session cookies. Any random 32+ characters:  openssl rand -base64 48
SESSION_SECRET=

# Model provider for /api/chat: demo (default, no network, no cost) | gemini | groq | openrouter | anthropic (paid, opt-in)
PROVIDER=gemini
# Free key, no billing account: aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model. Default is Google's latest Flash alias, falling back to gemini-3.5-flash.
GEMINI_MODEL=
# Other providers, only read when PROVIDER selects them
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Set to 1 to switch every model call off at once
KARIGAR_PAUSED=

# Self-hosted Whisper for /api/transcribe (optional until transcription is built out)
WHISPER_URL=
WHISPER_TOKEN=

# Self-service sign-up is open by default. Require a shared code, or close it entirely.
SIGNUP_CODE=
SIGNUP_DISABLED=
