{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 300
    },
    "api/manifest.js": {
      "includeFiles": "public/manifest.webmanifest"
    },
    "api/artisan-page.js": {
      "includeFiles": "public/artisan.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/console"
    },
    {
      "source": "/k/:token",
      "destination": "/api/artisan-page?t=:token"
    },
    {
      "source": "/org",
      "destination": "/console"
    },
    {
      "source": "/org/:path*",
      "destination": "/console"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
